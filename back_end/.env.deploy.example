# GraphDB Configuration
GRAPHDB_IMAGE=ontotext/graphdb:11.4.2
GRAPHDB_REPO=Project

# Security Keys (ต้องมีความยาวอย่างน้อย 32 ตัวอักษร ใน Production)
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars
JWT_SECRET_KEY=change-this-to-another-secure-random-string-at-least-32-chars

# Production Public Domain (ใช้สำหรับ Caddy Reverse Proxy & HTTPS อัตโนมัติ)
# เช่น diabalance.yourdomain.com
SITE_DOMAIN=example.com

# LINE Bot Integration (ถ้าไม่ใช้ ให้เว้นว่างไว้)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Google Gemini API Key (สำหรับ OCR / AI แนะนำ)
GEMINI_API_KEY=

# Email OTP Notification
sender_email=
app_password=
