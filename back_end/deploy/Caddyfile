{$SITE_DOMAIN} {
    encode zstd gzip

    header {
        # ป้องกัน Clickjacking (Medium: Missing Anti-clickjacking Header)
        X-Frame-Options "SAMEORIGIN"

        # ป้องกัน MIME Sniffing (Low: X-Content-Type-Options Header Missing)
        X-Content-Type-Options "nosniff"

        # บังคับใช้ HTTPS ตลอด 1 ปี (Low: Strict-Transport-Security Header Not Set)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # ป้องกัน XSS และจำกัดแหล่งโหลดสคริปต์ (Medium: Content Security Policy)
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net data:; img-src 'self' data: https://*.googleusercontent.com https://lh3.googleusercontent.com; connect-src 'self' https://accounts.google.com https://oauth2.googleapis.com; frame-src 'self' https://accounts.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://accounts.google.com; object-src 'none';"

        # ควบคุมการส่งข้อมูล Referrer ปลอดภัย
        Referrer-Policy "strict-origin-when-cross-origin"

        # ปิดการเข้าถึงฮาร์ดแวร์ที่ไม่จำเป็น
        Permissions-Policy "geolocation=(), microphone=(), camera=()"

        # ป้องกันการเก็บแคชข้อมูลสำคัญ (Info/Low: Re-examine Cache-control Directives)
        Cache-Control "no-store, no-cache, must-revalidate"
    }

    reverse_proxy web:8000
}

